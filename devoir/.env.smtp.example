# Configuration Gmail : copier ce fichier en .env.smtp puis remplacer les valeurs.
# Activer la validation en deux étapes et créer un mot de passe d’application Google.
# Ne jamais publier .env.smtp ni transmettre le mot de passe dans le chat.
# Garder false pendant la saisie ; passer à true pour activer les rappels réels.
MAIL_ENABLED=false
MAIL_FROM=votre-adresse@gmail.com
MAIL_TO=destinataire@exemple.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre-adresse@gmail.com
# Les guillemets simples préservent les caractères spéciaux dans Docker Compose.
SMTP_PASSWORD='MOT_DE_PASSE_APPLICATION_GOOGLE'
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# Si votre fournisseur exige TLS implicite (port 465), utiliser :
# SMTP_PORT=465
# SMTP_STARTTLS=false
# SMTP_SSL=true
