# Valeurs de développement local. Choisir un mot de passe avant le premier démarrage.
DATABASE_NAME=pacte
DATABASE_USER=pacte
DATABASE_PASSWORD=change-me-local-pacte
DATABASE_PORT=5432
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/pacte
SERVER_PORT=8080
PACTE_DEMO_ENABLED=true

# IA : clé conservée côté serveur. Laisser vide pour désactiver les analyses.
OPENAI_API_KEY=ta_cle_api
OPENAI_MODEL=gpt-4.1-mini

# Rappels e-mail : désactivés tant que SMTP et destinataires ne sont pas renseignés.
MAIL_ENABLED=true
MAIL_FROM=pacte@example.test
MAIL_TO=responsable@example.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
OCR_LANGUAGES=fra+eng
