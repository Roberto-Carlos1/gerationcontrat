# Valeurs de développement local. Choisir un mot de passe avant le premier démarrage.
DATABASE_NAME=pacte
DATABASE_USER=pacte
DATABASE_PASSWORD=change-me-local-pacte
DATABASE_PORT=5432
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/pacte
SERVER_PORT=8080
PACTE_DEMO_ENABLED=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Rappels e-mail : Mailpit local pour les tests. Pour les vraies adresses, voir .env.smtp.example.
MAIL_ENABLED=true
MAIL_FROM=pacte@example.test
MAIL_TO=responsable@example.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
OCR_LANGUAGES=fra+eng

# IA locale : aucune clé API nécessaire.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
AI_ENDPOINT=http://127.0.0.1:11434/api/chat
AI_TIMEOUT_SECONDS=300
